option('boxtype', type : 'combo', choices : ['generic', 'coolstream', 'armbox', 'mipsbox'], value : 'generic',
	description : 'Hardware neutrino is built for')
option('stb-hal-includes', type : 'string', value : '',
	description : 'Path to the libstb-hal headers, default includedir/libstb-hal')

option('configdir', type : 'string', value : '', description : 'Config files, default localstatedir/tuxbox/config')
option('zapitdir', type : 'string', value : '', description : 'Zapit files, default localstatedir/tuxbox/config/zapit')
option('tuxboxdatadir', type : 'string', value : '', description : 'Data files, default datadir/tuxbox')
option('datadir_var', type : 'string', value : '', description : 'Data files in /var, default localstatedir/tuxbox')
option('controldir', type : 'string', value : '', description : 'Control scripts, default datadir/tuxbox/neutrino/control')
option('controldir_var', type : 'string', value : '', description : 'Control scripts in /var, default localstatedir/tuxbox/control')
option('fontdir', type : 'string', value : '', description : 'Fonts, default datadir/fonts')
option('fontdir_var', type : 'string', value : '', description : 'Fonts in /var, default localstatedir/tuxbox/fonts')
option('gamesdir', type : 'string', value : '', description : 'Games, default localstatedir/tuxbox/games')
option('tuxboxlibdir', type : 'string', value : '', description : 'Internal libraries, default libdir/tuxbox')
option('plugindir', type : 'string', value : '', description : 'Plugins, default datadir/tuxbox/neutrino/plugins')
option('plugindir_var', type : 'string', value : '', description : 'Plugins in /var, default localstatedir/tuxbox/plugins')
option('plugindir_mnt', type : 'string', value : '/mnt/plugins', description : 'External plugins')
option('luaplugindir', type : 'string', value : '', description : 'Lua plugins, default datadir/tuxbox/neutrino/luaplugins')
option('luaplugindir_var', type : 'string', value : '', description : 'Lua plugins in /var, default localstatedir/tuxbox/luaplugins')
option('webradiodir', type : 'string', value : '', description : 'Webradio content, default datadir/tuxbox/neutrino/webradio')
option('webradiodir_var', type : 'string', value : '', description : 'Webradio content in /var, default localstatedir/tuxbox/webradio')
option('webtvdir', type : 'string', value : '', description : 'WebTV content, default datadir/tuxbox/neutrino/webtv')
option('webtvdir_var', type : 'string', value : '', description : 'WebTV content in /var, default localstatedir/tuxbox/webtv')
option('localedir_neutrino', type : 'string', value : '', description : 'Locales, default datadir/tuxbox/neutrino/locale')
option('localedir_var', type : 'string', value : '', description : 'Locales in /var, default localstatedir/tuxbox/locale')
option('themesdir', type : 'string', value : '', description : 'Themes, default datadir/tuxbox/neutrino/themes')
option('themesdir_var', type : 'string', value : '', description : 'Themes in /var, default localstatedir/tuxbox/themes')
option('iconsdir', type : 'string', value : '', description : 'Icons, default datadir/tuxbox/neutrino/icons')
option('iconsdir_var', type : 'string', value : '', description : 'Icons in /var, default localstatedir/tuxbox/icons')
option('lcd4liconsdir', type : 'string', value : '', description : 'LCD4Linux icons, default datadir/tuxbox/neutrino/lcd/icons')
option('lcd4liconsdir_var', type : 'string', value : '', description : 'LCD4Linux icons in /var, default localstatedir/tuxbox/lcd/icons')
option('logodir', type : 'string', value : '', description : 'Channel logos, default datadir/tuxbox/neutrino/icons/logo')
option('logodir_var', type : 'string', value : '', description : 'Channel logos in /var, default localstatedir/tuxbox/icons/logo')
option('private_httpddir', type : 'string', value : '', description : 'Private httpd files, default datadir/tuxbox/neutrino/httpd')
option('public_httpddir', type : 'string', value : '', description : 'Public httpd files, default localstatedir/tuxbox/httpd')
option('hosted_httpddir', type : 'string', value : '/mnt/hosted', description : 'Hosted httpd files')
option('flagdir', type : 'string', value : '', description : 'Flag files, default localstatedir/etc')

option('default-theme', type : 'string', value : '', description : 'Default theme of the GUI')
option('weather-api-key', type : 'string', value : '', description : 'OpenWeather API key')
option('weather-api-version', type : 'string', value : '', description : 'OpenWeather API version')
option('tmdb-api-key', type : 'string', value : '', description : 'TMDb API key')
option('omdb-api-key', type : 'string', value : '', description : 'OMDb API key')
option('shoutcast-dev-id', type : 'string', value : '', description : 'Shoutcast developer ID')
option('youtube-api-key', type : 'string', value : '', description : 'YouTube API key')
option('weather-key-manage', type : 'boolean', value : false, description : 'Manage the OpenWeather API key in the GUI')
option('tmdb-key-manage', type : 'boolean', value : false, description : 'Manage the TMDb API key in the GUI')
option('omdb-key-manage', type : 'boolean', value : false, description : 'Manage the OMDb API key in the GUI')
option('shoutcast-id-manage', type : 'boolean', value : false, description : 'Manage the Shoutcast developer ID in the GUI')
option('youtube-key-manage', type : 'boolean', value : false, description : 'Manage the YouTube API key in the GUI')

option('network-backend', type : 'combo', choices : ['ifupdown', 'networkd'], value : 'ifupdown',
	description : 'What configures the wired interfaces')
option('iwd', type : 'boolean', value : false, description : 'Connect to wireless networks through iwd instead of wpa_supplicant')
option('bluetooth', type : 'boolean', value : false, description : 'Pair and connect Bluetooth devices through BlueZ')
option('mpris', type : 'boolean', value : false, description : 'Let desktop media keys control playback through MPRIS')
option('tray', type : 'boolean', value : false, description : 'Show an icon in the tray of the desktop')
option('xkbcommon', type : 'boolean', value : false, description : 'Type text with a keyboard in its layout through libxkbcommon')
option('terminal', type : 'boolean', value : false, description : 'Run plugins with a text user interface in a terminal on the OSD')
option('udisks', type : 'boolean', value : false, description : 'Mount drives through udisksctl when not running as root')
option('xmltv-xz', type : 'boolean', value : false, description : 'Read XMLTV files packed with xz')
option('assistant', type : 'boolean', value : false, description : 'Ask a language model that operates the box')
option('assistant-voice', type : 'boolean', value : false, description : 'Ask the assistant by voice')
option('webp', type : 'boolean', value : false, description : 'Show WebP pictures')
option('heif', type : 'boolean', value : false, description : 'Show HEIF, HEIC and AVIF pictures')
option('jxl', type : 'boolean', value : false, description : 'Show JPEG XL pictures')
option('fribidi', type : 'boolean', value : false, description : 'Bidirectional text through fribidi')
option('upnp', type : 'boolean', value : true, description : 'UPnP browser')
option('lua', type : 'boolean', value : true, description : 'Lua plugins')
option('lua-provider', type : 'combo', choices : ['auto', 'luajit', 'lua'], value : 'auto', description : 'Lua backend')
option('udev', type : 'boolean', value : false, description : 'Leave mounting and the kernel hotplug helper to udev')
option('libsecret', type : 'boolean', value : false, description : 'Keep API keys in the Secret Service of the desktop session')
option('mdev', type : 'boolean', value : false, description : 'Leave mounting to mdev')
option('freesatepg', type : 'boolean', value : false, description : 'Freesat EPG')
option('viasatepg', type : 'boolean', value : false, description : 'ViaSat EPG')
option('fastscan', type : 'boolean', value : false, description : 'Fastscan')
option('aitscan', type : 'boolean', value : true, description : 'Application Information Table')
option('pip', type : 'boolean', value : false, description : 'Picture in picture')
option('lcd4linux', type : 'boolean', value : false, description : 'LCD4Linux')
option('graphlcd', type : 'boolean', value : false, description : 'GraphLCD')
option('extupdate', type : 'boolean', value : false, description : 'Extended update routine')
option('pkg-management', type : 'boolean', value : false, description : 'Package management in the GUI')
option('keyboard-no-rc', type : 'boolean', value : false, description : 'Keyboard control instead of a remote control')
option('dynamicdemux', type : 'boolean', value : false, description : 'Dynamic demux')
option('cleanup', type : 'boolean', value : false, description : 'Clean up on exit')
option('testing', type : 'boolean', value : false, description : 'Development code')
option('change-osd-resolution', type : 'boolean', value : true, description : 'Allow changing the OSD resolution')
option('webif', type : 'boolean', value : true, description : 'Install the bundled web interface')
