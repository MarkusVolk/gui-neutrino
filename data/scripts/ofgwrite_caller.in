#!/bin/sh
# flashes the image file $2 with ofgwrite and its options $3. It is
# unpacked beside the slot directories, which is faster than a stick and
# where restore_flash.sh removes it, or else into $1. ofgwrite does not
# come back when it flashes the slot running: it stops Neutrino, writes
# from RAM and restarts the box

for i in $(cat /proc/cmdline); do
	case "$i" in
		root=*) DEV=${i#root=} ;;
		rootsubdir=*) SUB=${i#rootsubdir=} ;;
	esac
done
ROOT=$(awk -v d="$DEV" '$1 == d && $2 != "/" { print $2; exit }' /proc/mounts)
[ -n "$SUB" ] && [ -n "$ROOT" ] && DIR="$ROOT/.ofgwrite" || DIR="$1/.ofgwrite"

rm -rf "$DIR"
mkdir -p "$DIR" || exit 1
case "$2" in
	*.zip) unzip -o -q "$2" -d "$DIR" ;;
	*) tar -xzf "$2" -C "$DIR" ;;
esac
IMG=$(find "$DIR" -name rootfs.tar.bz2 | head -n 1)
if [ -z "$IMG" ]; then
	echo "no rootfs.tar.bz2 in $2"
	rm -rf "$DIR"
	exit 1
fi

ofgwrite $3 "$(dirname "$IMG")"
RET=$?
[ "${3#-m}" = "$(echo "$SUB" | sed 's/.*[^0-9]//')" ] || rm -rf "$DIR"
exit $RET
