#!/bin/sh
# keeps the settings for the image flashed into the slot of the STARTUP
# file $1 beside its slot directory, where ofgwrite leaves them;
# restore_flash.sh puts them back at the first start of that image

. "$(dirname "$0")/flash_slot.sh"
slot_of "$1" && slot_root || exit 1
BAKF="$ROOT/.neutrino-restore-$SUB.tar.gz"

# the system files a box needs to come up as before, whatever an older
# tobackup.conf in CONFIGDIR lists
TOBACKUP="@CONFIGDIR@ /etc/ssh/ssh_host_* /etc/hostname /etc/localtime /etc/timezone
	/etc/network/interfaces /etc/wpa_supplicant.conf /var/lib/iwd /var/lib/tailscale"
[ -e "@CONFIGDIR@/tobackup.conf" ] && TOBACKUP="$TOBACKUP $(sed 's/#.*//' "@CONFIGDIR@/tobackup.conf")"
RES=""
for i in $TOBACKUP; do
	case "$i" in @CONFIGDIR@/*) continue ;; esac
	[ -e "$i" ] && RES="$RES $i"
done

echo "Backup to $BAKF"
tar -czf "$BAKF" $RES
RET=$?
slot_done
exit $RET
