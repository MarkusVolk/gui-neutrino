#!/bin/sh
# keeps the settings for the image flashed into slot $1 beside the slot
# directories, where ofgwrite leaves them; restore_flash.sh puts them back
# at the first start of that image

for i in $(cat /proc/cmdline); do
	case "$i" in
		root=*) DEV=${i#root=} ;;
		rootsubdir=*) SUB=${i#rootsubdir=} ;;
	esac
done
ROOT=$(awk -v d="$DEV" '$1 == d && $2 != "/" { print $2; exit }' /proc/mounts)
[ -n "$1" ] && [ -n "$SUB" ] && [ -n "$ROOT" ] || exit 1
BAKF="$ROOT/.neutrino-restore-$(echo "$SUB" | sed 's/[0-9]*$//')$1.tar.gz"

TOBACKUP="@CONFIGDIR@ /etc/ssh/ssh_host_*"
[ -e "@CONFIGDIR@/tobackup.conf" ] && TOBACKUP="$TOBACKUP $(sed 's/#.*//' "@CONFIGDIR@/tobackup.conf")"
RES=""
for i in $TOBACKUP; do
	case "$i" in @CONFIGDIR@/*) continue ;; esac
	[ -e "$i" ] && RES="$RES $i"
done

echo "Backup to $BAKF"
tar -czf "$BAKF" $RES
